{
  "expo": {
    "name": "annotated",
    "slug": "annotated",
    "scheme": "annotated",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F4F0",
    "primaryColor": "#33383F",
    "ios": {
      "bundleIdentifier": "co.armytage.annotated",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.armytage.annotated",
      "adaptiveIcon": {
        "backgroundColor": "#F3F1ED",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "extra": {
      "origin": "https://annotated-staging.up.railway.app",
      "eas": {
        "projectId": "1655592c-905a-426f-97af-3eeaafd7a0c2"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      "expo-router",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "annotated uses the microphone to record the short voice notes you attach to a source."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F5F4F0"
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-image"
    ],
    "owner": "tcballard-oss",
    "updates": {
      "url": "https://u.expo.dev/1655592c-905a-426f-97af-3eeaafd7a0c2"
    }
  }
}
