# Local development uses the file adapter by default. Production must set
# ANNOTATED_STORAGE=postgres and ANNOTATED_ASSET_STORAGE=s3.
ANNOTATED_STORAGE=file
ANNOTATED_ASSET_STORAGE=local
ANNOTATED_DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:8787
PORT=8787

# Production metadata
# NODE_ENV=production
# ANNOTATED_STORAGE=postgres
# DATABASE_URL=postgresql://user:password@db.example/annotated
# PGSSL=require
# PG_POOL_MAX=10

# Production media (AWS S3, Cloudflare R2, or another S3-compatible service)
# ANNOTATED_ASSET_STORAGE=s3
# S3_BUCKET=annotated-media
# S3_REGION=auto
# S3_ENDPOINT=https://account.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_URL_TTL_SECONDS=900
