# Local development uses the file adapter by default. Production must set
# ANNOTATED_STORAGE=postgres and ANNOTATED_ASSET_STORAGE=s3.
ANNOTATED_STORAGE=file
ANNOTATED_ASSET_STORAGE=local
ANNOTATED_DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:8787
PORT=8787
# The production container overrides this to 0.0.0.0; local development stays loopback-only.
HOST=127.0.0.1
# Production readiness probes this executable before serving provider jobs.
YTDLP_BIN=yt-dlp
# The production image includes Node for yt-dlp's YouTube challenge/runtime path.
YTDLP_JS_RUNTIME=node
# YouTube may challenge shared hosting egress. Configure these only with a
# managed proxy and a secret-mounted cookie file; never commit cookie contents.
# YTDLP_PROXY=https://proxy.example:8443
# YTDLP_COOKIES_FILE=/run/secrets/youtube.cookies
# YTDLP_PLAYER_CLIENT=web_safari
MEDIA_WORKER_MAX_ATTEMPTS=3
MEDIA_WORKER_RETRY_DELAY_MS=1500
# Kill a stuck provider, FFmpeg, or FFprobe process before its persisted lease expires.
MEDIA_WORKER_PROCESS_TIMEOUT_MS=300000
# Persisted job leases prevent duplicate claims across app instances and let a
# restarted process recover queued or expired processing jobs.
MEDIA_WORKER_LEASE_MS=600000
# Bound simultaneous calls per provider and pause a repeatedly failing provider.
MEDIA_WORKER_PROVIDER_CONCURRENCY=2
MEDIA_WORKER_BREAKER_FAILURES=5
MEDIA_WORKER_BREAKER_COOLDOWN_MS=60000
# Production API processes are queue-only and reject a nonzero value. Run
# `npm run worker` as a separate service and set its concurrency there.
# MEDIA_WORKER_CONCURRENCY=0
# Worker service only: MEDIA_WORKER_CONCURRENCY=4
# Production PostgreSQL-backed abuse buckets use a small dedicated pool.
PG_RATE_LIMIT_POOL_MAX=4
# The backup command runs from a trusted runner with pg_dump installed. Keep
# its output outside the repository and use a new directory per run.
# PG_DUMP_BIN=pg_dump
# BACKUP_OUTPUT_DIR=/secure/annotated-backups/20260804T120000Z
# BACKUP_MAX_OBJECTS=100000
# Set these strict flags only when the provider has the corresponding policy.
# BACKUP_REQUIRE_OBJECT_VERSIONING=true
# BACKUP_REQUIRE_OBJECT_LIFECYCLE=true
# BACKUP_DIR=/secure/annotated-backups/20260804T120000Z
# RUN_RECOVERY_DRILL=true
# RECOVERY_DATABASE_URL=postgresql://user:password@db.example/annotated_recovery_20260804
# Scheduled production backups require a distinct S3-compatible archive bucket.
# BACKUP_ARCHIVE_REQUIRED=true
# BACKUP_ARCHIVE_BUCKET=annotated-backups
# BACKUP_ARCHIVE_PREFIX=annotated/production
# BACKUP_ARCHIVE_REGION=auto
# BACKUP_ARCHIVE_ENDPOINT=https://archive.example.com
# BACKUP_ARCHIVE_FORCE_PATH_STYLE=false
# BACKUP_ARCHIVE_ACCESS_KEY_ID=...
# BACKUP_ARCHIVE_SECRET_ACCESS_KEY=...
# BACKUP_ARCHIVE_REQUIRE_OBJECT_VERSIONING=true
# BACKUP_ARCHIVE_REQUIRE_OBJECT_LIFECYCLE=true
# Set this only when a stable worker identity is needed for diagnostics.
# MEDIA_WORKER_ID=annotated-worker-1
# Protects /api/operator/metrics; use at least 24 random characters in deployment.
# OPERATOR_METRICS_TOKEN=...

# Production metadata
# NODE_ENV=production
# ANNOTATED_STORAGE=postgres
# DATABASE_URL=postgresql://user:password@db.example/annotated
# PGSSL=require
# PG_POOL_MAX=10

# Production media (Railway Buckets, AWS S3, Cloudflare R2, or another
# S3-compatible service). For Railway, map the bucket's BUCKET, REGION,
# ENDPOINT, ACCESS_KEY_ID, and SECRET_ACCESS_KEY variable references to these.
# ANNOTATED_ASSET_STORAGE=s3
# S3_BUCKET=annotated-media
# S3_REGION=auto
# S3_ENDPOINT=https://storage.railway.app
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# Leave S3_PUBLIC_BASE_URL unset for the private, signed-URL Railway POC profile.
# The API redirects /media/:id to a short-lived S3 API URL; do not add a public
# bucket or browser-held storage credentials.
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# Public CDN takedown invalidation (not needed for private signed URLs).
# MEDIA_CDN_PURGE_ENDPOINT=https://cdn-control.example.com/purge
# MEDIA_CDN_PURGE_TOKEN=...
# S3_URL_TTL_SECONDS=900

# Required when NODE_ENV=production. The brief requires X or Google sign-in,
# so both providers are enabled by default (OAUTH_PROVIDERS=x,google) and
# production fails fast at boot unless BOTH pairs of credentials below are set.
# Narrow OAUTH_PROVIDERS only for local experiments, never for a deployed build.
# AUTH_REQUIRED=true
# AUTH_SESSION_TTL_SECONDS=2592000
# OAUTH_PROVIDERS=x,google
# APP_ORIGIN=https://annotated.example.com
# CORS_ORIGINS=https://annotated.example.com
# Stable IDs for packaged Chrome builds; comma-separate additional approved IDs.
# CHROME_EXTENSION_IDS=omlikcdpcdhfmdojdalfdeihgjmgikkg
# MODERATOR_USER_IDS=user-id-1,user-id-2
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://annotated.example.com/api/auth/google/callback
# X_CLIENT_ID=...
# X_CLIENT_SECRET=...
# X_REDIRECT_URI=https://annotated.example.com/api/auth/x/callback
