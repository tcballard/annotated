{
  "manifest_version": 3,
  "name": "annotated — keep the moment",
  "version": "0.1.0",
  "description": "Clip a moment from the page you are on, add your context, and keep the source attached.",
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "identity", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_title": "Open annotated" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
