{
  "manifest_version": 3,
  "key": "",
  "name": "annotated — keep the moment",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "description": "Clip a moment from the page you are on, add your context, and keep the source attached.",
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "identity", "alarms", "contextMenus"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+A", "mac": "Alt+A" },
      "description": "Open the annotated panel"
    }
  },
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png", "1024": "icons/icon-1024.png" },
  "action": { "default_title": "Open annotated", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png", "1024": "icons/icon-1024.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
